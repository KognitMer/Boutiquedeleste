# Nunca guardes las credenciales reales en GitHub.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SITE_URL=https://boutiquedeleste.com

# Correo SMTP para enviar la orden al cliente y una copia privada a Freddy.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ventas@boutiquedeleste.com
SMTP_PASS=xxxxxxxxxxxxxxxx
ORDER_FROM_EMAIL=ventas@boutiquedeleste.com
ORDER_COPY_EMAIL=correo-de-freddy@ejemplo.com

# Carpeta persistente y escribible del VPS. No debe borrarse en cada publicación.
ORDER_DATA_DIR=/var/lib/boutiquedeleste
